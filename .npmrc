# Cadena de suministro — endurecimiento (CONVENCIONES-APPS.md §1.1).
#
# Aquí importa el doble: este paquete corre DTLS y SCTP dentro del proceso que guarda la
# llave maestra. La poda quitó 21 mantenedores de en medio; esto se ocupa de los 7 que
# quedan.
#
# No ejecutar lifecycle scripts de dependencias: es el vector #1 de inyección en npm.
ignore-scripts=true
# Versiones EXACTAS: sin esto, una dependencia recién comprometida entra sola en la
# siguiente instalación. Subir de versión queda como un cambio explícito y auditable.
save-exact=true
fund=false
